# Required for uploads. API_KEY is accepted as a fallback name.
OPENAI_API_KEY=sk-...

# Vector store to sync. If unset, the job looks up VECTOR_STORE_NAME and creates it if missing.
VECTOR_STORE_ID=
VECTOR_STORE_NAME=optibot-kb

# Max NEW articles uploaded per run (backfill throttle). 0 = unlimited.
MAX_NEW_PER_RUN=100

# Where clean Markdown articles are written.
OUTPUT_DIR=articles

# Model used by ask.py for the CLI sanity check.
OPENAI_MODEL=
